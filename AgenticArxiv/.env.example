# 复制为 .env 后按实际情况修改（.env 不会被提交到 git）

# ---- 数据库 ----
MYSQL_URI=mysql+pymysql://arxiv:your_password@127.0.0.1:3306/agentic_arxiv?charset=utf8mb4

# ---- LLM（OpenAI 兼容接口）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
MODEL=deepseek-chat

# ---- 翻译（pdf2zh）----
PDF2ZH_SERVICE=openai:deepseek-chat
PDF2ZH_THREADS=4
# 若 pdf2zh 不在 PATH 中，可显式指定：
# PDF2ZH_BIN=/path/to/pdf2zh

# ---- Agent 模式：regex | mcp | skill_cli ----
AGENT_TYPE=regex

# ---- 可选：存储路径（默认在 AgenticArxiv/output 下）----
# PDF_RAW_PATH=./output/pdf_raw
# PDF_TRANSLATED_PATH=./output/pdf_translated
# PDF_TRANSLATED_LOG_PATH=./output/pdf_translated_log
